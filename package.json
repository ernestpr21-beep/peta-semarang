{
  "name": "peta-semarang",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Peta interaktif Kota Semarang dengan estimasi kisaran harga pasar tanah berbasis data pembanding (iklan) — bukan NJOP.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "start": "node server.mjs",
    "data:clean": "python3 data-pipeline/clean_listings.py",
    "data:build": "python3 data-pipeline/build_app_data.py",
    "build:pages": "BASE_PATH=/peta-semarang/ npm run build"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "clsx": "^2.1.1",
    "leaflet": "1.9",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
